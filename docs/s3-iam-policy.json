{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucketIsRequired",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::shortly-videos-bucket"
    },
    {
      "Sid": "ReadOriginalsAndWrittenLadder",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::shortly-videos-bucket/raw/*",
        "arn:aws:s3:::shortly-videos-bucket/hls/*"
      ]
    },
    {
      "Sid": "WriteLadder",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::shortly-videos-bucket/hls/*"
    },
    {
      "Sid": "DeleteRejectedUploadsAndPartialOutput",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::shortly-videos-bucket/raw/*",
        "arn:aws:s3:::shortly-videos-bucket/hls/*"
      ]
    }
  ]
}
